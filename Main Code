def search(records):
    print("Choose the field")
    print("1. NIC")
    print("2. Full Name")
    print("3. Gender")
    print("4. Bank Name")
    print("5. Bank Account Number")
    print("6. Damage Category")
    print("7. Divisional Sector")
    print("8. District")

    option = input("Enter your choice(1/2/3/4/5/6/7/8): ").strip()
    search_value = input("What you want to search? ").strip()

    field_map = {   ##map the users choice with the actual records
        "1": "NIC",
        "2": "Full Name",
        "3": "Gender",
        "4": "Bank Name",
        "5": "Bank Account Number",
        "6": "Damage Category",
        "7": "Divisional Sector",
        "8": "District"
    }

    if option not in field_map: #check if the choice is valid
        print("Invalid choice")
        return

    field = field_map[option]  #get the actual field name ot search
    matches = []

    for record in records:
        if field in ["NIC", "Bank Account Number", "Compensation Amount"]:
            try:
                if int(record[field]) == int(search_value): #numerical fields checking
                    matches.append(record)
            except ValueError:
                pass
        else:
            if str(record[field]).lower() == search_value.lower(): #nonnumerical fields checking
                matches.append(record)

    if len(matches) == 0:
        print("No records found.")
        return

    display(matches)  #will display the matching records


def display(records):
    total_compensation = 0
    print("The Compensation Management DataBase")
    print(  #to print headers
        f"{'NIC':<8}| {'Full Name':<22} |{'Gender':<10}|{'Bank Name':<18}|"
        f"{'Bank Account Number':<20}| {'Damage Category':<22}| {'Compensation Amount':<20}|"
        f" {'Divisional Sector':<18}|{'District':<10}"
    )

    for record in records:
        total_compensation += int(record["Compensation Amount"])
        print(
            f"{int(record['NIC']):<8} {record['Full Name']:<22} {record['Gender']:<10} "
            f"{record['Bank Name']:<18} {int(record['Bank Account Number']):>20} "
            f"{record['Damage Category']:>25} {int(record['Compensation Amount']):>20} "
            f"{record['Divisional Sector']:>15} {record['District']:>12}"
        )

    print("-" * 150)
    print(f"Total Compensation:{total_compensation:>110}")
    print("-" * 150)


