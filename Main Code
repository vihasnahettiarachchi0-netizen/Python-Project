def ensure_csv_exists():
    try:  # try to open the csv file in read mode
        with open(FILE_NAME, "r", encoding="utf-8"):
            return True #if the file exists return true
    except FileNotFoundError:
        with open(FILE_NAME, "w", newline="", encoding="utf-8") as f: #this will open the file in write mode to create a new csv file
            writer = csv.DictWriter(f, fieldnames=CSV_HEADERS)
            writer.writeheader() #to write the header row to the csv file
        return False


def save_to_csv(records):
    ensure_csv_exists() #makes sure that the csv is existed
    with open(FILE_NAME, "w", newline="", encoding="utf-8") as f: #open csv in write mode
        writer = csv.DictWriter(f, fieldnames=CSV_HEADERS)
        writer.writeheader() #write the header row to the file
        for record in records:
            writer.writerow({    #write each record as a  row  in the csv file
                "NIC": int(record["NIC"]),
                "Full Name": record["Full Name"],
                "Gender": record["Gender"],
                "Bank Name": record["Bank Name"],
                "Bank Account Number": int(record["Bank Account Number"]),
                "Damage Category": record["Damage Category"],
                "Compensation Amount": int(record["Compensation Amount"]),
                "Divisional Sector": record["Divisional Sector"],
                "District": record["District"],
            })


def load_from_csv(default_records):
    created = not ensure_csv_exists()
    #check if the csv exists

    if created:
        save_to_csv(default_records) #if the file just created save default records to new file
        return default_records #retrun the default records


#open the csv in read mode
    with open(FILE_NAME, "r", newline="", encoding="utf-8") as f:
        reader = csv.DictReader(f) #will creat data as dictionaries
        data = [] #empty list to store records
        for row in reader:
            if not row or row.get("NIC") is None or row.get("NIC") == "":  #null values ignored
                continue
            row["NIC"] = int(row["NIC"])  #convert into integers
            row["Bank Account Number"] = int(row["Bank Account Number"])
            row["Compensation Amount"] = int(row["Compensation Amount"])
            data.append(row)

#if no valid record were found  in the file
    if len(data) == 0:
        save_to_csv(default_records) #save records to the file
        return default_records

    return data
    #resturn the data from the csv file

#defining the function to add a new entry
def insert_new_entry(records):
    while True:
        try:
            nic = int(input("Enter the NIC having Five Digits: "))
            if 10000 <= nic <= 99999:
                break
            print("NIC must be exactly 5 digits.")
        except ValueError:
            print("Please enter a valid NIC")

    full_name = input("Enter your Full Name: ")

    gender = input("Enter your Gender: ").lower()
    if gender in ["male", "m"]:
        gender = "M"
    elif gender in ["female", "f"]:
        gender = "F"
    else:
        gender = gender.upper()

    bank_name = input("Enter your Bank Name: ")

    while True:
        try:
            bank_account_number = int(input("Enter your Bank Account Number: "))
            break
        except ValueError:
            print("Please enter a valid Bank Account Number")

    # printing the three options  in the damage category
    while True:
        print("Select the Damage Category")
        print(" 1. Fully Damaged")
        print(" 2. Only Property Damaged")
        print(" 3. Only Flooding")

        damage_choice = input("Select your choice(1/2/3): ").strip()

        if damage_choice == "1":
            damage_category = "Fully Damaged"
            compensation_amount = 5000000
            break
        elif damage_choice == "2":
            damage_category = "Only Property Damaged"
            compensation_amount = 1000000
            break
        elif damage_choice == "3":
            damage_category = "Only Flooding"
            compensation_amount = 50000
            break
        else:
            print("Invalid damage category, try again.")

    divisional_sector = input("Enter your Divisional Sector: ")
    district = input("Enter your District: ")


#new records will be added to the list
    records.append({
        "NIC": nic,
        "Full Name": full_name,
        "Gender": gender,
        "Bank Name": bank_name,
        "Bank Account Number": bank_account_number,
        "Damage Category": damage_category,
        "Compensation Amount": compensation_amount,
        "Divisional Sector": divisional_sector,
        "District": district
    })

    save_to_csv(records) #to save all records to csv file
    return records #updated list will be return

# defining the function to delete a record
def delete_record(records):
    while True:
        try:
            nic = int(input("Enter the NIC to remove: "))
            break
        except ValueError:
            print("Please enter a valid NIC")

    for record in records:
        if int(record["NIC"]) == nic:
            records.remove(record)
            save_to_csv(records)
            print("NIC has been removed")
            return records

    print("Record not found")
    return records


